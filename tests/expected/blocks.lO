' Several DATA and PROC definitions
DATA a() BYTE = 1, 2, 3
DATA b() BYTE = 4, 5, 6

PROC show
  PRINT a(0), b(0)
ENDPROC

FOR i = 0 TO 9
  IF i > 5 THEN PRINT i
NEXT i
DATA c() BYTE = 7, 8, 9
DATA big() BYTE = $12, $23, $45,
DATA BYTE = $08, $09, $15

PROC other x
  PRINT c(1) + x, big(4)
ENDPROC

EXEC show
EXEC other 5
